# ============================================================
# VivaAI — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env
# ============================================================

# ------ App ------
APP_ENV=development            # development | production
SECRET_KEY=change_me_in_prod   # JWT signing key
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ------ Database ------
POSTGRES_USER=vivaai
POSTGRES_PASSWORD=vivaai_pass
POSTGRES_DB=vivaai
DATABASE_URL=postgresql+asyncpg://vivaai:vivaai_pass@postgres:5432/vivaai

# ------ Redis ------
REDIS_URL=redis://redis:6379/0

# ------ MinIO / S3 ------
MINIO_ROOT_USER=vivaai_minio
MINIO_ROOT_PASSWORD=vivaai_minio_pass
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=vivaai-audio
AWS_ACCESS_KEY_ID=vivaai_minio
AWS_SECRET_ACCESS_KEY=vivaai_minio_pass
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000

# ------ LiveKit ------
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# ------ STT (Deepgram) ------
DEEPGRAM_API_KEY=                 # leave blank for MOCK MODE

# ------ TTS ------
# Providers: elevenlabs | openai | mock
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=               # leave blank for MOCK MODE
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM # optional custom ElevenLabs voice ID (Rachel)
OPENAI_API_KEY=                   # used for TTS + LLM if set

# ------ LLM ------
# Providers: openai | anthropic | mock
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=                # leave blank for MOCK MODE

# Fast model (live interview)
LLM_FAST_MODEL=gpt-4o-mini
# Strong model (scoring)
LLM_STRONG_MODEL=gpt-4o

# ------ Mock Mode ------
# Set MOCK_MODE=true to run entirely with fake STT/TTS/LLM (no API keys needed)
MOCK_MODE=true

# ------ Next.js public vars ------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_STUDENT_URL=http://localhost:3000
NEXT_PUBLIC_FACULTY_URL=http://localhost:3001
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_MOCK_MODE=true

# Same-origin browser gateway (server-only backend address)
API_INTERNAL_URL=http://127.0.0.1:8000
# Local development runs the durable database scorer in the API process.
# Production Compose disables it in the API and starts a separate scoring-worker.
SCORING_WORKER_ENABLED=true

# Hindi/Hinglish live speech uses the multilingual model, independently of English.
DEEPGRAM_MULTILINGUAL_MODEL=nova-3

# Retention stays disabled until an institution approves a policy and period.
# No automatic deletion job is enabled; scripts/retention.py plans by default.
RETENTION_DAYS=0
RETENTION_POLICY_ID=
